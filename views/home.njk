{% extends "layouts/app.njk" %}
{# Provides the authenticated application home page. #}

{% block title %}Trade Tank: Home{% endblock %}

{% block content %}
    <div class="main-container">
        <div class="copy">
            <h1>Home</h1>
            <p>
                Use the Trade Tank pages to record, review, and understand
                your trading performance.
            </p>

            <ul>
                <li>
                    <strong><a href="/analyze">Analyze</a>:</strong>
                    Review your overall trading statistics. Drag and drop
                    any statistic box to change its position; your preferred
                    order is saved automatically.
                </li>

                <li>
                    <strong><a href="/visualize">Visualize</a>:</strong>
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                </li>

                <li>
                    <strong><a href="/trades">Trades</a>:</strong>
                    Browse your submitted trades. Each trade box starts
                    collapsed; select one to expand its details and load its
                    candlestick chart, then select it again to collapse it.
                </li>

                <li>
                    <strong><a href="/input">Input</a>:</strong>
                    Load a trading date and enter the contract count. Select
                    Buy or Sell first, then click the candlestick chart at the
                    intended time and price to place the order. Close the
                    position, add notes, and save the chart when finished.
                </li>
            </ul>
        </div>
    </div>
{% endblock %}
