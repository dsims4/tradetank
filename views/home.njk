{% extends "layouts/app.njk" %}
{# Provides the authenticated application home page. #}

{% block title %}Trade Tank: Home{% endblock %}

{% block content %}
    <div class="main-container main-container--home">
        <header class="home-introduction">
            <h1 class="app-page-heading">Trade Tank Home</h1>
            <p class="home-description">
                Record each trading day, review individual trades, and find
                useful patterns in your performance.
            </p>
        </header>

        <nav class="home-page-grid" aria-label="Trade Tank pages">
            <a class="home-page-card" href="/input">
                <span class="home-page-card-heading">
                    <span>Input</span>
                </span>
                <span class="home-page-card-copy">
                    Plot orders on a candlestick chart, record notes, and save
                    a completed trading day.
                </span>
            </a>

            <a class="home-page-card" href="/trades">
                <span class="home-page-card-heading">
                    <span>Trades</span>
                </span>
                <span class="home-page-card-copy">
                    Return to submitted days and inspect one saved trade at a
                    time on its original chart.
                </span>
            </a>

            <a class="home-page-card" href="/analyze">
                <span class="home-page-card-heading">
                    <span>Analyze</span>
                </span>
                <span class="home-page-card-copy">
                    Review your calculated trading statistics and arrange the
                    measurements that matter most to you.
                </span>
            </a>

            <a class="home-page-card" href="/visualize">
                <span class="home-page-card-heading">
                    <span>Visualize</span>
                </span>
                <span class="home-page-card-copy">
                    Compare trading measurements on a configurable chart and
                    explore how they change over time.
                </span>
            </a>
        </nav>
    </div>
{% endblock %}
