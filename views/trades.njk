{% extends "layouts/app.njk" %}
{% from "partials/trading-date-picker.njk" import tradingDatePicker %}

{% block title %}Trade Tank: Trades{% endblock %}

{% block scripts %}
    <script defer src="/js/trading-date-picker.js"></script>
    <script defer src="/js/candlestick-chart.js"></script>
    <script defer src="/js/trades-chart.js"></script>
{% endblock %}

{% block content %}
    <div class="main-container main-container--input-chart main-container--trades-chart">
        <h1 class="app-page-heading">Trades</h1>

        <div class="input-chart-page trades-chart-page">
            <div class="input-chart-workspace trades-chart-workspace">
                <header class="input-chart-header trades-chart-header">
                    <form
                        class="input-chart-controls"
                        data-trades-chart-controls
                    >
                        <label for="trades-chart-date">
                            Trading date:
                        </label>

                        {{ tradingDatePicker(
                            "trades-chart-date",
                            "trades",
                            tradingSessionInceptionDate,
                            currentTradingDate
                        ) }}
                        <button type="submit" class="button">
                            Load
                        </button>
                    </form>

                    <div class="trades-chart-messages">
                        <p
                            class="input-chart-status"
                            data-trades-chart-status
                            aria-live="polite"
                        ></p>

                        <p
                            class="trades-chart-warning"
                            role="alert"
                            hidden
                            data-trades-chart-warning
                        ></p>
                    </div>
                </header>

                <div class="candlestick-chart-container">
                    <canvas
                        id="trades-candlestick-chart"
                        role="img"
                        aria-label="Saved trades candlestick chart"
                    ></canvas>
                </div>

                <h2 class="sidebar-heading chart-sidebar-heading">
                    Trades
                </h2>

                <aside
                    class="input-trade-sidebar trades-summary-sidebar"
                >
                    <div class="trades-summary-panel">
                        <div data-trade-summaries></div>

                        <nav
                            aria-label="Trade pages"
                            hidden
                            data-trade-pagination
                        >
                            <button
                                type="button"
                                class="button"
                                data-previous-trades
                            >
                                Previous
                            </button>

                            <span data-trade-page></span>

                            <button
                                type="button"
                                class="button"
                                data-next-trades
                            >
                                Next
                            </button>
                        </nav>

                        <button
                            type="button"
                            class="button"
                            hidden
                            data-delete-trading-day
                        >
                            Delete day
                        </button>
                    </div>
                </aside>
            </div>
        </div>
    </div>
{% endblock %}
