{% extends "layouts/app.njk" %}

{% block title %}Trade Tank: Trades{% endblock %}

{% block scripts %}
    <script defer src="/js/candlestick-chart.js"></script>
    <script defer src="/js/trades-chart.js"></script>
{% endblock %}

{% block content %}
    <div class="main-container main-container--trades-chart">
        <div class="trades-chart-page">
            <header class="trades-chart-header">
                <form data-trades-chart-controls>
                    <label for="trades-chart-date">
                        Trading date
                    </label>

                    <input
                        id="trades-chart-date"
                        class="form-input"
                        name="tradingDate"
                        type="text"
                        inputmode="numeric"
                        maxlength="10"
                        pattern="\d{4}-\d{2}-\d{2}"
                        placeholder="YYYY-MM-DD"
                        autocomplete="off"
                        required
                        data-trades-chart-date
                    >
                    <button type="submit" class="button">
                        Load
                    </button>
                </form>

                <p
                    data-trades-chart-status
                    aria-live="polite"
                ></p>
            </header>

            <div class="candlestick-chart-container">
                <canvas
                    id="trades-candlestick-chart"
                    role="img"
                    aria-label="Saved trades candlestick chart"
                ></canvas>
            </div>

            <aside class="trades-summary-sidebar">
                <h2>Trades</h2>

                <div data-trade-summaries></div>

                <button
                    type="button"
                    class="button"
                    hidden
                    data-delete-trading-day
                >
                    Delete chart
                </button>
            </aside>
        </div>
    </div>
{% endblock %}