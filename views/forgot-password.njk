{% extends "layouts/main.njk" %}
{# Collects the email address used to request a password-reset link. #}

{% block title %}Trade Tank: Forgot Password{% endblock %}

{% block content %}
    <div class="main-container main-container--account">
        <form method="POST" class="form">
            <div class="form-header">
                <h1>Forgot Password</h1>
                <p>Enter the email associated with your account.</p>
            </div>

            {% if errorMessage %}
                <p class="form-message form-message--error">
                    {{ errorMessage }}
                </p>
            {% endif %}

            <div class="form-fields">
                <div class="form-field">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        class="form-input"
                        name="email"
                        autocomplete="email"
                        maxlength="255"
                        required>
                </div>
            </div>

            <input type="submit" class="button" value="Send Reset Link">
        </form>
    </div>
{% endblock %}
