{# Related axis choices grouped for both the normal select and styled dropdown. #}
{% macro visualizeAxisOption(value, label, selectedValue) %}
    <option
        value="{{ value }}"
        {% if selectedValue == value %}selected{% endif %}
    >
        {{ label }}
    </option>
{% endmacro %}

{% macro visualizeXAxisOptions(selectedValue) %}
    <optgroup label="Timeline">
        {{ visualizeAxisOption(
            "time",
            "Time",
            selectedValue
        ) }}
    </optgroup>

    <optgroup label="Cumulative trade counts">
        {{ visualizeAxisOption(
            "trades",
            "Trades",
            selectedValue
        ) }}
        {{ visualizeAxisOption(
            "processDeviationTrades",
            "Trades with process deviation",
            selectedValue
        ) }}
        {{ visualizeAxisOption(
            "processFollowingTrades",
            "Trades without process deviation",
            selectedValue
        ) }}
        {{ visualizeAxisOption(
            "longTrades",
            "Long trades",
            selectedValue
        ) }}
        {{ visualizeAxisOption(
            "shortTrades",
            "Short trades",
            selectedValue
        ) }}
        {{ visualizeAxisOption(
            "scalingTrades",
            "Scaling trades",
            selectedValue
        ) }}
        {{ visualizeAxisOption(
            "nonScalingTrades",
            "Trades without scaling",
            selectedValue
        ) }}
    </optgroup>

    <optgroup label="Cumulative day counts">
        {{ visualizeAxisOption(
            "tradingDays",
            "Trading days",
            selectedValue
        ) }}
    </optgroup>
{% endmacro %}

