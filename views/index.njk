{% extends "layouts/main.njk" %}
{# Renders the public landing page and its feature slideshow. #}

{% block title %}Trade Tank: Index{% endblock %}

{% block content %}
<div class="main-container">
    <div class="copy copy--index">
        <h1>Welcome to Trade Tank</h1>
        <p>
            This platform serves users with specifically useful tools for trading
            analysis. With a simple and intuitive interface this application intends
            to thoroughly assist serious traders during their reflection.
        </p>

        <p class="index-access-notice">
            Full access is limited. To request access to every Trade Tank feature,
            email
            <a href="mailto:contact@tradetank.dev">contact@tradetank.dev</a>.
        </p>
    </div>

    <div class="slideshow">
        <button
            class="slideshow-button slideshow-button--left"
            type="button"
            aria-label="Previous slide">
            &lsaquo;
        </button>

        <div class="slideshow-slide slideshow-slide--middle">
            <img class="slideshow-image"
                 src="/images/trade-input.webp"
                 alt="Trade Tank Trade Input page"
                 decoding="async">
        </div>

        <div class="slideshow-slide slideshow-slide--side slideshow-slide--right">
            <img class="slideshow-image slideshow-image--side"
                 src="/images/trades.webp"
                 alt="Trade Tank Trades page"
                 decoding="async">
        </div>

        <div class="slideshow-slide slideshow-slide--hidden">
            <img class="slideshow-image"
                 src="/images/analyze.webp"
                 alt="Trade Tank Analyze page"
                 loading="lazy"
                 decoding="async">
        </div>

        <div class="slideshow-slide slideshow-slide--side slideshow-slide--left">
            <img class="slideshow-image slideshow-image--side"
                 src="/images/visualize.webp"
                 alt="Trade Tank Visualize page"
                 loading="lazy"
                 decoding="async">
        </div>

        <button
            class="slideshow-button slideshow-button--right"
            type="button"
            aria-label="Next slide">
            &rsaquo;
        </button>
    </div>

    <div class="call-to-action">
        <p>Enjoy the application, after creating an account and logging in.</p>

        <a class="button" href="/login">Log In</a>
        <div class="button-or">
            <hr>
            <p>Or</p>
            <hr>
        </div>
        <a id="index-signup-button" class="button" href="/signup">Sign Up</a>
    </div>
</div>
{% endblock %}
