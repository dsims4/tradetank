{% extends "layouts/app.njk" %}

{% block title %}Trade Tank: Input{% endblock %}

{% block content %}
    <div class="main-container">
        <div class="input-chart-page">
            <form class="input-chart-controls" data-input-chart-controls>
                <label for="trading-date">Trading date</label>
                <input
                    id="trading-date"
                    name="tradingDate"
                    type="text"
                    inputmode="numeric"
                    maxlength="10"
                    pattern="\d{4}-\d{2}-\d{2}"
                    placeholder="YYYY-MM-DD"
                    autocomplete="off"
                    required
                    data-input-chart-date
                >
                <button type="submit" class="button">Load</button>
            </form>

            <p data-input-chart-status aria-live="polite"></p>

            <div class="input-chart-workspace">
                <div class="candlestick-chart-container">
                    <canvas
                        id="candlestick-chart"
                        role="img"
                        aria-label="Five-minute candlestick chart"
                    ></canvas>
                </div>

                <aside class="input-trade-sidebar">
                    <form data-input-trade-form>
                        <fieldset disabled data-input-trade-fieldset>
                            <legend>Trade input</legend>

                            <label for="contract-count">
                                Contracts
                            </label>
                            <input
                                id="contract-count"
                                name="contractCount"
                                type="number"
                                min="1"
                                step="1"
                                value="1"
                                required
                                data-contract-count
                            >

                            <div class="input-trade-actions">
                                <button
                                    type="button"
                                    class="button"
                                    data-trade-action="buy"
                                    aria-pressed="false"
                                >
                                    Buy
                                </button>

                                <button
                                    type="button"
                                    class="button"
                                    data-trade-action="sell"
                                    aria-pressed="false"
                                >
                                    Sell
                                </button>

                                <button
                                    type="button"
                                    class="button"
                                    data-trade-action="close"
                                    aria-pressed="false"
                                >
                                    Close position
                                </button>
                            </div>

                            <div class="input-trade-history-actions">
                                <button
                                    type="button"
                                    class="button"
                                    disabled
                                    data-undo-order
                                >
                                    Undo
                                </button>

                                <button
                                    type="button"
                                    class="button"
                                    disabled
                                    data-reset-orders
                                >
                                    Reset
                                </button>
                            </div>

                            <label for="trade-notes">
                                Trade notes
                            </label>
                            <textarea
                                id="trade-notes"
                                name="notes"
                                maxlength="1500"
                                data-trade-notes
                            ></textarea>

                            <label>
                                <input
                                    name="processDeviation"
                                    type="checkbox"
                                    data-process-deviation
                                >
                                Process deviation
                            </label>

                            <button type="submit" class="button">
                                Save chart
                            </button>
                        </fieldset>
                    </form>

                    <section hidden data-completed-trades-section>
                        <h2>Completed trades</h2>
                        <div data-completed-trades></div>
                    </section>
                </aside>
            </div>
        </div>
    </div>
{% endblock %}